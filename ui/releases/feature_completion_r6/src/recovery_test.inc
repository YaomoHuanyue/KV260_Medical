void recoveryReviewTest(){
 try{
  auto report=scene["distal_recovery"].toObject();if(report.isEmpty()||!recoveryReviewButton->isEnabled()||!recoveryButton->isEnabled())throw std::runtime_error("Recovery controls missing");
  auto summary=report["summary"].toObject();QJsonObject counts;for(int bit:{2,8,16,32,64,128}){qint64 count=0;for(qint64 k=0;k<qint64(volume->dims[0])*volume->dims[1]*volume->dims[2];++k)if(volume->masks[k]&bit)++count;counts[QString::number(bit)]=double(count);}
  if(summary["high_confidence_candidates"].toInt()==0&&counts["32"]!=counts["2"])throw std::runtime_error("Empty high mask changed default display");
  if(summary["review_candidates"].toInt()>0&&counts["64"].toDouble()==0)throw std::runtime_error("Review mask not loaded");
  tabs->setCurrentIndex(0);auto rows=report["candidates"].toArray();if(!rows.isEmpty()){auto q=rows.first().toObject()["component_point_zyx"].toArray();axialSlider->setValue(q[0].toInt());slices[1]->setSlice(q[1].toInt());slices[2]->setSlice(q[2].toInt());}
  QJsonArray selected;for(int index:{0,3,4,5,0}){airwayOverlay->setCurrentIndex(index);int bit=airwayOverlay->currentData().toInt();for(auto*v:slices)if(v->airwayMaskBit()!=bit)throw std::runtime_error("Recovery overlay not synchronized");capture("recovery_overlay_"+QString::number(bit));selected.append(bit);}
  bool yellowVerified=summary["review_candidates"].toInt()==0;for(qint64 k=0;!yellowVerified&&k<qint64(volume->dims[0])*volume->dims[1]*volume->dims[2];++k){if(!(volume->masks[k]&64))continue;int x=k%volume->dims[0],y=(k/volume->dims[0])%volume->dims[1],z=k/(qint64(volume->dims[0])*volume->dims[1]);airwayOverlay->setCurrentIndex(4);axialSlider->setValue(z);auto c=slices[0]->sliceImage().pixelColor(x,y);yellowVerified=c.red()>c.blue()+25&&c.green()>c.blue()+25;break;}if(!yellowVerified)throw std::runtime_error("Review pixel is not yellow");airwayOverlay->setCurrentIndex(0);
  QTimer::singleShot(200,this,[this,rows]{auto*d=qobject_cast<QDialog*>(QApplication::activeModalWidget());if(!d){failed=true;return;}auto*t=d->findChild<QTableWidget*>();if(!t||t->rowCount()!=rows.size()||t->columnCount()!=7){failed=true;d->accept();return;}d->grab().save(evidence+"/recovery_evidence_dialog.png");if(rows.isEmpty())d->accept();else QMetaObject::invokeMethod(t,"cellClicked",Qt::DirectConnection,Q_ARG(int,0),Q_ARG(int,0));});showRecoveryReview();
  bool clickVerified=rows.isEmpty();if(!rows.isEmpty()){auto r=rows.first().toObject();auto q=r["component_point_zyx"].toArray();int bit=r["classification"]=="review"?64:r["classification"]=="high"?32:8;clickVerified=airwayOverlay->currentData().toInt()==bit&&slices[0]->currentSlice()==q[0].toInt()&&slices[1]->currentSlice()==q[1].toInt()&&slices[2]->currentSlice()==q[2].toInt();}if(!clickVerified)throw std::runtime_error("Evidence table did not locate actual CT voxel");airwayOverlay->setCurrentIndex(0);
  writeJson(evidence+"/recovery_ui_acceptance.json",QJsonObject{{"status",failed?"failed":"passed"},{"bit_counts",counts},{"selected_overlay_bits",selected},{"summary",summary},{"model_navigation_replaced",false},{"native_review_controls",true},{"actual_yellow_pixel_verified",yellowVerified},{"table_click_locates_CT",clickVerified}});
  QApplication::exit(failed?1:0);
 }catch(const std::exception&e){writeJson(evidence+"/recovery_ui_acceptance.json",QJsonObject{{"status","failed"},{"error",QString::fromUtf8(e.what())}});QApplication::exit(1);}
}
