          "// The UI scene has already passed",
          "inline bool sameSavedVideoScene(const QJsonObject&saved,const QJsonObject&displayed,QStringList*extraNulls=nullptr){\n // QJsonObject non-const operator[] inserts null for a missing read. Only\n // these additional top-level nulls are ignored; all saved values stay exact.\n for(auto it=saved.begin();it!=saved.end();++it)\n  if(!displayed.contains(it.key())||displayed.value(it.key())!=it.value())return false;\n for(auto it=displayed.begin();it!=displayed.end();++it)if(!saved.contains(it.key())){\n  if(!it.value().isNull())return false;\n  if(extraNulls)extraNulls->append(it.key());\n }\n return true;\n}\n// The UI scene has already passed"
        ],
        [
          " if(mediaObject(scenePath)!=scene)throw std::runtime_error(\"Displayed and saved video scene differ\");",
          " QStringList extraNulls;if(!sameSavedVideoScene(mediaObject(scenePath),scene,&extraNulls))throw std::runtime_error(\"Displayed and saved video scene differ\");"
        ],
        [
          "{\"render_backend\",\"PL_C9\"},{\"quality\",quality}",
          "{\"render_backend\",\"PL_C9\"},{\"extra_UI_null_keys\",QJsonArray::fromStringList(extraNulls)},{\"quality\",quality}"
        ]
      ]
